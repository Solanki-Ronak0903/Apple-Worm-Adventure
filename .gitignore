# Composer dependencies
/vendor/
/auth.json

# Node dependencies and generated frontend output
/node_modules/
/public/build/
/public/hot
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Laravel environment and runtime files
/.env
/.env.*
!/.env.example
/bootstrap/cache/*.php
/storage/*.key
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/public/storage

# Local databases and test state
/database/*.sqlite
/database/*.sqlite3
/.phpunit.result.cache
/.phpunit.cache/

# IDE and operating-system files
.idea/
.DS_Store
Thumbs.db
desktop.ini
